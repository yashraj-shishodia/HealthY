# Application Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Healthcare Appointment Manager"

# Database Configuration (PostgreSQL)
POSTGRES_USER=healthy_user
POSTGRES_PASSWORD=healthy_password
POSTGRES_DB=healthy_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://healthy_user:healthy_password@localhost:5432/healthy_db

# Redis & Background Tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Provider Configuration
LLM_PROVIDER=mock  # Options: mock, openai, gemini, anthropic
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-mini

# Email Provider Configuration
EMAIL_PROVIDER=mock  # Options: mock, sendgrid, smtp
EMAIL_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@healthyapp.com

# Google Calendar Integration (OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/calendar/callback

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
